DATABASE_URL="postgresql://lightcrm:lightcrm@localhost:54329/lightcrm?schema=public"
LIGHTCRM_WORKSPACE_ID="default"

# File/document storage placeholders.
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="C:/repos/LightCrm/.local-storage"
S3_ENDPOINT="https://example.r2.cloudflarestorage.com"
S3_BUCKET="your-bucket"
S3_REGION="auto"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"

# LLM providers.
OPENAI_API_KEY="replace-me"
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""

# Telegram integration.
# Internal server-to-server URL used by the Telegram bot to call CRM APIs.
LIGHTCRM_API_BASE="http://localhost:4900"
# Canonical public HTTPS CRM URL used by Google OAuth redirects, logout, backups, and Telegram WebApp buttons.
# Production: https://lightcrm.204-168-163-99.sslip.io
# Test: https://lightcrm-test.204-168-163-99.sslip.io
NEXT_PUBLIC_APP_URL="https://lightcrm.204-168-163-99.sslip.io"
NEXTAUTH_URL="https://lightcrm.204-168-163-99.sslip.io"
TELEGRAM_BOT_TOKEN="replace-me"
TELEGRAM_ALLOWED_CHAT_IDS="123456789,987654321"

# Web login. Google OAuth must allow
# http://localhost:3004/api/auth/google/callback for local testing,
# https://lightcrm.204-168-163-99.sslip.io/api/auth/google/callback in production,
# and https://lightcrm-test.204-168-163-99.sslip.io/api/auth/google/callback in test.
GOOGLE_CLIENT_ID="replace-me.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-me"
LIGHTCRM_SESSION_SECRET="replace-with-a-long-random-string"
LIGHTCRM_INTERNAL_API_TOKEN="replace-with-shared-web-and-telegram-token"
