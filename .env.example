DATABASE_URL="postgresql://lightcrm:lightcrm@localhost:54329/lightcrm?schema=public"
LIGHTCRM_WORKSPACE_ID="default"

# File/document storage placeholders.
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="C:/repos/LightCrm/.local-storage"
S3_ENDPOINT="https://example.r2.cloudflarestorage.com"
S3_BUCKET="your-bucket"
S3_REGION="auto"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"

# LLM providers.
OPENAI_API_KEY="replace-me"
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""

# Telegram integration.
LIGHTCRM_API_BASE="http://localhost:4900"
# Public HTTPS CRM URL used by Telegram WebApp buttons in production.
NEXT_PUBLIC_APP_URL="https://crm.example.com"
TELEGRAM_BOT_TOKEN="replace-me"
TELEGRAM_ALLOWED_CHAT_IDS="123456789,987654321"
